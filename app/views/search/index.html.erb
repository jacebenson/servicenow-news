<% content_for :title, "Search ServiceNow - News Jace Pro" %>
<% @show_nav_tabs = true %>

<div class="mx-auto max-w-7xl py-12">
  <section class="mx-auto max-w-4xl text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">News Jace Pro</p>
    <h1 class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-6xl">Find something about ServiceNow.</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600">Search the maintained index of news, partners, applications, financial activity, events, sessions, and MVPs.</p>

    <%= form_with url: search_path, method: :get, class: "mx-auto mt-8 flex max-w-3xl gap-2", local: true do %>
      <%= search_field_tag :q, @query, autofocus: true, placeholder: "Search Moveworks, CMDB, Knowledge 26...", class: "min-w-0 flex-1 rounded-xl border-slate-300 px-5 py-4 text-base shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      <%= submit_tag "Search", class: "cursor-pointer rounded-xl bg-blue-600 px-6 py-4 font-semibold text-white hover:bg-blue-700" %>
    <% end %>
  </section>

  <% if @query.blank? %>
    <section class="mx-auto mt-14 max-w-5xl">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% [["News and community", "Browse articles, videos, podcasts, and saved source material.", items_path], ["Partners", "Find companies, services, products, and ecosystem links.", partners_path], ["Applications", "Search the ServiceNow Store application index.", applications_path], ["Financial activity", "Follow acquisitions, investments, and public filings.", financials_path], ["Events and sessions", "Find talks across Knowledge and other event collections.", events_path], ["MVPs", "Explore the people and awards shaping the ecosystem.", mvps_path]].each do |title, description, path| %>
          <%= link_to path, class: "group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-md" do %>
            <h2 class="font-bold text-slate-950 group-hover:text-blue-700"><%= title %> <span aria-hidden="true">→</span></h2>
            <p class="mt-2 text-sm leading-6 text-slate-600"><%= description %></p>
          <% end %>
        <% end %>
      </div>
    </section>
  <% else %>
    <section class="mx-auto mt-12 max-w-6xl">
      <div class="flex flex-col gap-4 border-b border-slate-200 pb-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm text-slate-500">Results for</p>
          <h2 class="text-2xl font-bold text-slate-950">“<%= @query %>”</h2>
        </div>
        <div class="flex flex-wrap gap-2 text-sm">
          <%= link_to "All", search_path(q: @query), class: "rounded-full border px-3 py-1.5 #{params[:type].blank? ? 'border-blue-600 bg-blue-50 text-blue-700' : 'border-slate-300 text-slate-600'}" %>
          <% @search[:groups].each do |type, group| %>
            <%= link_to "#{SearchDocument::TYPES.fetch(type, type.humanize)} #{group[:count]}", search_path(q: @query, type: type), class: "rounded-full border px-3 py-1.5 #{params[:type] == type ? 'border-blue-600 bg-blue-50 text-blue-700' : 'border-slate-300 text-slate-600'}" %>
          <% end %>
        </div>
      </div>

      <% if @search[:total_count].zero? %>
        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-10 text-center">
          <h2 class="text-xl font-bold text-slate-950">Nothing in the local index matched that.</h2>
          <p class="mt-2 text-slate-600">Try a broader phrase, a company name, or a different spelling. This search only covers records maintained on News Jace Pro.</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <%= link_to "Browse news", items_path, class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700" %>
            <%= link_to "Browse events", events_path, class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700" %>
            <%= link_to "Clear search", search_path, class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white" %>
          </div>
        </div>
      <% else %>
        <% if @search[:exact_matches].any? %>
          <section class="mt-8">
            <div class="mb-3 flex items-baseline justify-between">
              <h2 class="text-lg font-bold text-slate-950">Exact matches</h2>
              <span class="text-sm text-slate-500"><%= @search[:exact_matches].length %></span>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <% @search[:exact_matches].each do |result| %>
                <%= render "search/result", result: result %>
              <% end %>
            </div>
          </section>
        <% end %>

        <div class="mt-10 space-y-10">
          <% @search[:groups].each do |type, group| %>
            <section>
              <div class="mb-3 flex items-baseline justify-between">
                <div>
                  <h2 class="text-lg font-bold text-slate-950"><%= SearchDocument::TYPES.fetch(type, type.humanize) %></h2>
                  <p class="text-sm text-slate-500"><%= group[:count] %> matching records</p>
                </div>
                <% if group[:count] > group[:results].length %>
                  <%= link_to "View all →", search_path(q: @query, type: type), class: "text-sm font-semibold text-blue-600 hover:text-blue-800" %>
                <% end %>
              </div>
              <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <% group[:results].each do |result| %>
                  <%= render "search/result", result: result %>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>

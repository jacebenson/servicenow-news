<% external = result[:record_type] == "news" && result[:source_url].present? %>
<% destination = external ? result[:source_url] : result[:local_path] %>
<% target = external ? "_blank" : nil %>
<% rel = external ? "noopener" : nil %>

<article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-blue-300 hover:shadow-md">
  <div class="flex items-center justify-between gap-3 text-xs font-semibold uppercase tracking-wide text-slate-500">
    <span><%= result[:type_label] %></span>
    <% if result[:occurred_at].present? %>
      <span><%= result[:occurred_at].to_date.strftime("%b %Y") rescue result[:occurred_at] %></span>
    <% end %>
  </div>
  <h3 class="mt-2 text-base font-bold leading-snug text-slate-950"><%= link_to result[:title], destination, target: target, rel: rel, class: "hover:text-blue-700" %></h3>
  <% if result[:subtitle].present? %>
    <p class="mt-1 text-sm text-slate-500"><%= result[:subtitle] %></p>
  <% end %>
  <% if result[:excerpt].present? %>
    <p class="mt-3 text-sm leading-6 text-slate-600"><%= sanitize(result[:excerpt], tags: %w[mark], attributes: []).html_safe %></p>
  <% end %>
  <div class="mt-4 flex items-center justify-between gap-3 text-sm">
    <%= link_to result[:destination_label], destination, target: target, rel: rel, class: "font-semibold text-blue-600 hover:text-blue-800" %>
    <% if external %>
      <%= link_to "Open local record", result[:local_path], class: "text-slate-500 hover:text-slate-700" %>
    <% end %>
  </div>
</article>

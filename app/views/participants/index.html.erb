<% content_for :title, "People - News Jace Pro" %>

<div class="mx-auto max-w-6xl py-10">
  <div class="mb-8 flex flex-col gap-4 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">People</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950">People shaping the ServiceNow ecosystem</h1>
      <p class="mt-3 max-w-2xl text-slate-600">Profiles connected to news, events, MVP awards, and partner records maintained on News Jace Pro.</p>
    </div>
    <%= form_with url: people_path, method: :get, class: "flex w-full max-w-sm gap-2", local: true do |f| %>
      <%= f.search_field :search, value: @search, placeholder: "Search people", class: "min-w-0 flex-1 rounded-lg border-slate-300 px-4 py-3 text-sm focus:border-blue-500 focus:ring-blue-500" %>
      <%= f.submit "Search", class: "rounded-lg bg-slate-950 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-800" %>
    <% end %>
  </div>

  <% if @participants.any? %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @participants.each do |participant| %>
        <%= link_to person_path(name: participant.slug), class: "flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-md" do %>
          <% if participant.image_url.present? %>
            <img src="<%= participant.image_url %>" alt="<%= participant.name %>" class="h-12 w-12 rounded-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
            <div class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-full bg-slate-200 font-medium text-slate-500"><%= participant.name.split.map(&:first).join.upcase[0, 2] %></div>
          <% else %>
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-slate-200 font-medium text-slate-500"><%= participant.name.split.map(&:first).join.upcase[0, 2] %></div>
          <% end %>
          <div class="min-w-0">
            <p class="truncate font-semibold text-slate-900"><%= participant.name %></p>
            <% if participant.title.present? || participant.company_name.present? %>
              <p class="truncate text-sm text-slate-500"><%= [participant.title, participant.company_name].compact_blank.join(" at ") %></p>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="mt-8">
      <%= paginate @participants %>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center text-slate-600">
      No public people matched that search.
    </div>
  <% end %>
</div>
